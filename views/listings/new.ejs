<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2" >
        <br>
    <h3>Create a New Listing</h3>
    <form  method="Post" action="/listings">
        <div>
             <label for="title" class="form-label">Title</label>
        <input name="listing[title]" placeholder="Enter title" type="text" class="form-control">
        </div>
        <br>
        <div>
            <label for="description" class="form-label">Description</label>
            <textarea 
             placeholder="Enter description"
            class="form-control">
            </textarea>
        </div>
        
        
        <div>
            <label for="Image" class="form-label">Image</label>
            <input name="listing[image]" placeholder="Enter url/link" type="text" class="form-control">
        </div>

        <br>
        <div class="row">
              <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" placeholder="1200" type="number" class="form-control">
        </div>
       
          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
        <input name="listing[country]" placeholder="India" type="text" class="form-control">
        </div>
        </div>
<br>
           <div>
            <label for="location" class="form-label">Location</label>
        <input name="listing[location]" placeholder="Punjab" type="text" class="form-control">
        </div>
        <br>
        
        <button class=" btn btn-dark add-btn">Add</button>
        <br>
    </form>
    </div>
</div>

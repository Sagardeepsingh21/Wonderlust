<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2" >
        <br>
    <h3>Create a New Listing</h3>
    <form  method="Post" action="/listings" novalidate class="needs-validation">
        <div>
             <label for="title" class="form-label">Title</label>
        <input name="listing[title]" placeholder="Enter title" type="text" class="form-control" required>
        </div>
        <br>
        <div class="Valid-feedback">Title looks good!</div>
        <div>
            <label for="description" class="form-label">Description</label>
            <textarea 
            name ="listing[description]" placeholder="Enter description" class="form-control" required>
        
            </textarea>
             <div class="invalid-feedback">Enter description</div>
        </div>
        
        
        <div>
            <label for="Image" class="form-label">Image</label>
            <input name="listing[image]" placeholder="Enter url/link" type="text" class="form-control" required>
       <div class="invalid-feedback">Enter Image URL </div>
        </div>

        <br>
        <div class="row">
              <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" placeholder="1200" type="number" class="form-control" required>
        <div class="invalid-feedback">Please Enter Valid Price!</div>
        </div>
       
        
       
          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
        <input name="listing[country]" placeholder="India" type="text" class="form-control" required>
    <div class="invalid-feedback">Please Enter valid country</div>   
    </div>
        </div>
<br>
           <div>
            <label for="location" class="form-label">Location</label>
        <input name="listing[location]" placeholder="Punjab" type="text" class="form-control" required>
    <div class="invalid-feedback">Please Enter Valid Location!</div>    
    </div>
        <br>
        
        <button class=" btn btn-dark add-btn mt-3">Add</button>
       
    </form>
    </div>
</div>
